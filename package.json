{
  "name": "@forst/dsh-toolkit",
  "version": "0.1.0",
  "description": "DSH 定制插件包：服务器资源、OpenCode Go 月额度、Pi 会话费用及可选 Camoufox 接入。",
  "type": "module",
  "main": "./index.js",
  "exports": {".": "./index.js", "./client": "./client.js", "./package.json": "./package.json", "./cordis.patch.yml": "./cordis.patch.yml"},
  "files": ["index.js", "client.js", "cordis.patch.yml", "plugins", "host", "integrations", "examples", "docs", "scripts/install-host-metrics.py", "scripts/build-client.mjs", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE.md"],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "npm run build",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {"node": ">=24.9", "dsh": "^0.2.2-alpha.2"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-modules", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"]}
  },
  "repository": {"type": "git", "url": "https://github.com/blueforst/dsh-toolkit.git"},
  "homepage": "https://github.com/blueforst/dsh-toolkit#readme",
  "bugs": {"url": "https://github.com/blueforst/dsh-toolkit/issues"},
  "license": "MIT",
  "sourceBaselines": {"server-metrics": "0.1.6", "session-billing": "0.1.4"}
}
